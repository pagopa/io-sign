meta {
  name: get-api-key-access-control
  type: http
  seq: 4
}

get {
  url: {{io-sign-backoffice-func-base-url}}/api-keys/:id/access-control
  body: none
  auth: inherit
}

params:path {
  id: {{backoffice_api_key_id}}
}

vars:pre-request {
  backoffice_api_key_id: io-sign-demo-subscription
}

settings {
  encodeUrl: true
  timeout: 0
}
