meta {
  name: create-filled-document
  type: http
  seq: 8
}

post {
  url: {{io-func-sign-user-base-url}}/sign/qtsp/clauses/filled_document
  body: json
  auth: inherit
}

headers {
  x-iosign-fiscal-code: {{fiscal_code}}
  x-iosign-name: {{name}}
  x-iosign-family-name: {{family_name}}
}

body:json {
  {
    "document_url": "{{document_url}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
