<policies>
    <inbound>
        <base />
        <set-backend-service base-url="{{io-fn-sign-issuer-url}}/api/v1/sign" />
        <set-header name="x-functions-key" exists-action="override">
            <value>{{io-fn-sign-issuer-key}}</value>
        </set-header>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
